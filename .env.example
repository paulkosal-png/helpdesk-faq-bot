# Copy to .env and fill in. NEVER commit .env.
# Use a personal/test Slack workspace for development - never your employer's.

# --- Slack (api.slack.com/apps) ---
SLACK_BOT_TOKEN=xoxb-your-bot-token          # OAuth & Permissions > Bot User OAuth Token
SLACK_APP_TOKEN=xapp-your-app-level-token    # Basic Information > App-Level Tokens (scope: connections:write)

# --- FAQ source ---
# auto = Google Sheet if GOOGLE_SHEET_ID + credentials are set, otherwise the local CSV
FAQ_SOURCE=auto
FAQ_CSV_PATH=data/sample_faq.csv
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=secrets/service-account.json   # share the sheet with this account's email
FAQ_SHEET_NAME=FAQ
UNANSWERED_SHEET_NAME=Unanswered Questions
FAQ_CACHE_SECONDS=60

# --- RAG fallback ---
RAG_ENABLED=true
KB_DIR=docs/sample_kb
RAG_TOP_K=4
RAG_MIN_SCORE=0.25          # hashing embedder: ~0.25; sentence-transformers / OpenAI embeddings: try 0.35-0.45
# hashing (offline default) | sentence-transformers | openai
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# For EMBEDDING_BACKEND=openai (defaults to the LLM_* values below if unset)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- LLM (any OpenAI-compatible endpoint). Leave LLM_BASE_URL empty to disable: unmatched -> escalate ---
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.2   (no key needed)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# --- Ops ---
METRICS_PORT=8000
ESCALATION_CONTACT=the IT team (#it-help)
LOG_LEVEL=INFO
UNANSWERED_LOG=logs/unanswered.jsonl
